{
  "name": "touhourpg/touhourpg",
  "type": "project",
  "description": "the touhou rpg.",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "laravel/ui": "^4.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "require-dev": {
    "laravel/breeze": "^2.4"
  }
}
